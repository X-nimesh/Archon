# Port the API listens on. Must not collide with the frontend (3000).
PORT=3001

# Signing secret for issued JWTs. REQUIRED when NODE_ENV=production —
# generate one with: openssl rand -base64 32
# If unset in development a random secret is generated at boot, which means
# restarting the backend invalidates every existing session.
JWT_SECRET=

# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# Not yet connected.
DATABASE_URL=postgresql://user:password@localhost:5432/archon