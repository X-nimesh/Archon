{
  "name": "archon",
  "version": "0.0.0",
  "private": true,
  "description": "Archon monorepo — NestJS API + Next.js control-plane UI",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@archon/backend",
    "dev:frontend": "turbo run dev --filter=@archon/frontend",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "turbo run format",
    "check": "turbo run lint typecheck test",
    "clean": "turbo run clean && rimraf node_modules",
    "graph": "turbo run build --graph=html"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "turbo": "^2.11.7"
  }
}